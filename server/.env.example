# 后端服务环境变量模板
# 复制为 .env 并填入你的真实值（部署到云平台时，在平台后台的 Environment Variables 里配置）

# ---------- Express ----------
PORT=9091

# ---------- Supabase（数据存储）----------
# 你自己的 Supabase 项目凭证（Supabase 后台 -> Project Settings -> API）
# 注意：请用你自己项目的 URL 和密钥；请到 Supabase 后台确认 tasks 表结构与本项目一致
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ---------- 计划管家智能体（排程对话）----------
# 你已发布的「计划管家」agent 的 OpenAI 兼容地址（公网可访问）
PLAN_AGENT_URL=https://cnhd38mqpq.coze.site/v1/chat/completions
# 调用该 agent 所需的 workload token（从扣子平台该项目/工作负载获取）
COZE_WORKLOAD_API_TOKEN=
# 会话标识，保持稳定即可
PLAN_AGENT_SESSION=longshuilin-app

# ---------- 排期超载告警 ----------
# 每日可用工作分钟数（默认 480 = 8 小时）
# OVERLOAD_WORK_MINUTES=480